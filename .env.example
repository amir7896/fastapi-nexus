PROJECT_NAME="Nexus"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# If password has @ * # / % : encode them first.
# Example: password Amir-AS@*7896 -> Amir-AS%40%2A7896
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/nexus

JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel
