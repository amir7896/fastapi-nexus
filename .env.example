PROJECT_NAME="Nexus"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# If password has @ * # / % : encode them first.
# Example: password MyP@ss*123 -> MyP%40ss%2A123
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/nexus

JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel
# Customer-paid processing fee (US cards default: 2.9% + $0.30)
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED=0.30

# Resend (https://resend.com/api-keys) — leave blank to log OTP codes in development
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nexus <onboarding@resend.dev>"
PASSWORD_RESET_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true
# Optional frontend routes (emails send OTP codes, not links)
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email

# Product images — one switch: cloudinary | s3
IMAGE_STORAGE_PROVIDER=cloudinary

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional CDN / custom domain. Defaults to the regional S3 URL.
AWS_S3_PUBLIC_BASE_URL=
